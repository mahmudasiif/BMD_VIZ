# ─── Large input data (exceeds GitHub's 100 MB limit) ───────────────────────
# ECMWF NetCDF comes from the fimex/OPeNDAP pipeline; fetch separately.
*.nc

# ─── Generated artifacts (reproducible via scripts/process_ecmwf.py) ────────
data/viz/
data/lightning/

# ─── Ingest drop folder (raw .nc files land here; keep the dir, ignore data) ─
data/incoming/*
!data/incoming/.gitkeep

# ─── Logs ───────────────────────────────────────────────────────────────────
*.log

# ─── Node / Playwright ──────────────────────────────────────────────────────
node_modules/
package-lock.json

# ─── Driver screenshots (regenerated by the run skill) ──────────────────────
.claude/skills/run-bmd-viz/screenshots/

# ─── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
.venv/
venv/

# ─── OS / editor ────────────────────────────────────────────────────────────
.DS_Store
*.swp
